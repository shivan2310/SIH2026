# QuantumLab environment variables
# Copy this file to ".env" and fill in the values for your own backend project.

# ==============================================================================
# CORE PLATFORM (Lovable Cloud / Supabase)
# ==============================================================================
# Supabase has a generous free tier for database and authentication.
# Public, client-safe values
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-only equivalents (used by server functions/edge functions)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ==============================================================================
# AI TUTORING SYSTEM (Zero-Cost / Free Alternatives)
# ==============================================================================
# We will use Ollama for local, free AI processing, or a free-tier API.

# Option A: Local Ollama (100% Free, runs on your machine)
VITE_OLLAMA_URL="http://localhost:11434"
# VITE_AI_MODEL="llama3"

# Option B: Free API (e.g., Google Gemini Free Tier or Groq)
# VITE_GEMINI_API_KEY="YOUR_GEMINI_FREE_KEY"

# ==============================================================================
# QUANTUM BACKENDS (Zero-Cost / Local Simulation)
# ==============================================================================
# Instead of paid cloud quantum services, we will use a local open-source Python 
# server to run Qiskit Aer, PennyLane, and Cirq simulators for free.

VITE_LOCAL_QUANTUM_SERVER="http://localhost:8000"

# Note: IBM Quantum offers free tier access for real hardware if you ever want it:
# IBM_QUANTUM_TOKEN="YOUR_FREE_IBM_TOKEN"
