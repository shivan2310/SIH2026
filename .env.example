# QuantumLab environment variables
# Copy this file to ".env" and fill in the values.

# ==============================================================================
# AUTH & SESSION
# ==============================================================================
# Secret key used to sign JWT session tokens. Change this in production!
SESSION_SECRET="change-me-to-a-random-secret"

# ==============================================================================
# AI TUTORING SYSTEM
# ==============================================================================
# Option A: Local Ollama (free, runs on your machine)
VITE_OLLAMA_URL="http://localhost:11434"
VITE_AI_MODEL="llama3"

# Option B: Google Gemini API (free tier available)
# Set the URL to the Gemini OpenAI-compatible endpoint and provide your API key.
# VITE_OLLAMA_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# VITE_AI_MODEL="gemini-2.0-flash"
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ==============================================================================
# QUANTUM BACKENDS (Local Simulation)
# ==============================================================================
# Local Python server running Qiskit Aer, PennyLane, and Cirq simulators.
VITE_LOCAL_QUANTUM_SERVER="http://localhost:8000"
